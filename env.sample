# Copy to `.env` before running `docker compose up` (or `just up`).
#
# Host port the MCP server binds to. The container itself always listens on 8000.
MCP_HOST_PORT=8002

# Infrastructure
SEARXNG_URL=http://searxng:8080
CRAWL4AI_URL=http://crawl4ai:11235
VALKEY_URL=redis://valkey:6379/0

# Performance
REQUEST_TIMEOUT=30
MAX_RESULTS=20
MAX_SCRAPE=10
# Coarse cache TTL default. Set to 0 to disable caches unless a specific
# per-cache override below is set. Optional per-cache TTLs default to sane
# values: SearXNG 15m, page/semantic 24h, seen URLs 1h.
CACHE_TTL_S=3600
# SEARXNG_CACHE_TTL_S=900
# PAGE_CACHE_TTL_S=86400
# SEEN_URL_TTL_S=3600
# CONTENT_ALIAS_TTL_S=86400
# SEMANTIC_CACHE_TTL_S=86400

# Reranking. The default English CrossEncoder balances quality and CPU
# latency on the bundled eval set. FlashRank remains available via:
# RERANK_BACKEND=flashrank
# RERANK_MODEL=ms-marco-MiniLM-L-12-v2
# Only this configured backend/model is loaded; alternatives documented
# in README.md are not downloaded unless selected here.
RERANK_BACKEND=sentence-transformers
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L4-v2
RERANK_DEVICE=cpu
RERANK_BATCH_SIZE=16
RERANK_MAX_LENGTH=512

# Quality (optional)
# CPU/RAM-only semantic cache. Keep GPU/VRAM reserved for your inference model.
# TTL-bounded Valkey Search HNSW index over cached evidence. Old
# ENABLE_SEMANTIC_INDEX is still accepted for compatibility.
ENABLE_SEMANTIC_CACHE=1
SEMANTIC_BACKEND=valkey-search
SEMANTIC_MIN_SCORE=0.45
SEMANTIC_MAX_CHUNKS_PER_PAGE=40
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
SEMANTIC_TOP_K=20

# Image pins. Override to bump versions without editing docker-compose.yml.
SEARXNG_IMAGE=docker.io/searxng/searxng:2026.4.16-ae0b0e56a
CRAWL4AI_IMAGE=unclecode/crawl4ai:0.8.6
VALKEY_IMAGE=valkey/valkey-bundle:9.0.1
